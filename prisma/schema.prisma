generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model ClothingItem {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  imagePath       String
  name            String?
  category        String
  subcategory     String?
  primaryColor    String
  primaryColorHex String
  secondaryColor  String?
  pattern         String?
  fabric          String?
  fit             String?
  formality       Int
  seasons         String
  styleTags       String
  notes           String?
  active          Boolean  @default(true)
  role            String?
  silhouetteWidth String?
  stylingNote     String?
}

model Outfit {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  name        String
  theme       String
  itemIds     String
  description String?
  saved       Boolean  @default(false)
}

model StyleProfile {
  id             String   @id @default(cuid())
  updatedAt      DateTime @updatedAt
  aesthetics     String
  likedLooks     String
  colorPalette   String
  avoidColors    String
  formalityRange String
  notes          String?
}

model WardrobeGap {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  itemDescription String
  category        String
  reason          String
  outfitsUnlocked Int
  dismissed       Boolean  @default(false)
}

// Stores field-level corrections made in the tag review UI.
// These are injected as few-shot examples in future Claude tagging calls.
model TagCorrection {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  category    String
  subcategory String?
  field       String
  original    String
  corrected   String
}

model WearLog {
  id       String   @id @default(cuid())
  wornAt   DateTime @default(now())
  itemIds  String   // JSON array of ClothingItem IDs
  outfitId String?  // optional reference to a named Outfit
}
